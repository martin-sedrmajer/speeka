<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vox pro Android (.NET MAUI). Sdílí s Windows verzí jádro (soubory z ..\Vox) i webové rozhraní. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vox.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>Vox</ApplicationTitle>
    <!-- Identifikátor aplikace na Google Play; po prvním vydání už nejde změnit. -->
    <ApplicationId>io.github.martinsedrmajer.vox</ApplicationId>
    <ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- model se při prvním spuštění kopíruje z balíčku; nekomprimovaný se kopíruje rychleji -->
    <AndroidStoreUncompressedFileExtensions>.onnx;.bin</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <!-- Sdílené jádro z Windows projektu (bez Windows částí: WindowsTts, WindowsPlatform, WPF okno). -->
  <ItemGroup>
    <Compile Include="..\Vox\Bridge.cs" Link="Shared\Bridge.cs" />
    <Compile Include="..\Vox\Core\*.cs" Link="Shared\Core\%(Filename)%(Extension)" />
    <Compile Include="..\Vox\Voice\PiperTts.cs" Link="Shared\Voice\PiperTts.cs" />
    <Compile Include="..\Vox\Voice\KokoroVoices.cs" Link="Shared\Voice\KokoroVoices.cs" />
    <Compile Include="..\Vox\Voice\Wav.cs" Link="Shared\Voice\Wav.cs" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F8CFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0C1015" BaseSize="128,128" />
    <!-- webové rozhraní je stejné jako ve Windows -->
    <MauiAsset Include="..\Vox\wwwroot\**" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- model Supertonic: build-android.ps1 ho sem nakopíruje (v gitu není, je velký) -->
    <MauiAsset Include="Resources\Raw\voices\**" LogicalName="voices\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
